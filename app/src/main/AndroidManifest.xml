<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.helloworld">

    <!-- [修改] 蓝牙权限 - 更新为完整的BLE权限 -->
    <!-- Android 12 以下（<= API 30）：经典蓝牙权限 + 定位（BLE扫描需要） -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30"/>
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30"/>

    <!-- Android 12+（>= API 31）：新的BLE权限 -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"/>
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"/>
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE"/>

    <!-- [新增] 声明设备需要BLE能力 -->
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true"/>

    <!-- 前台服务权限 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <!-- 屏幕录制权限 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Android 14+ 需要的权限 -->
    <uses-permission android:name="android.permission.CAPTURE_VIDEO_OUTPUT" />

    <!-- 通知权限（Android 13+） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- NEW: 网络访问，用于拉取版本 JSON -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- NEW: 仅用于判断是否有网络 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>


    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.Helloworld"
        android:usesCleartextTraffic="true">

        <!-- ✅ 视频分析页面（支持横屏切换而不重建） -->
        <activity
            android:name=".VideoProcessActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize"
            android:screenOrientation="portrait" />


        <!-- 主页面 -->
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 在线分析Activity -->
        <activity
            android:name=".OnlineAnalysisActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize"
            android:launchMode="singleTask" />

        <!-- 网页视频Activity（In-app WebView + 视频流嗅探） -->
        <activity
            android:name=".WebVideoActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:screenOrientation="portrait" />

        <!-- 手动电子菜单（脱离视频分析，直接控制模式/强度） -->
        <activity
            android:name=".ManualControlActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize"
            android:parentActivityName=".MainActivity" />

        <!-- 在线分析服务 -->
        <service
            android:name=".OnlineAnalysisService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

    </application>
</manifest>