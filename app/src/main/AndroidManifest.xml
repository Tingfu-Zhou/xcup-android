<?xml version="1.0" encoding="utf-8"?>
<!-- 包名（applicationId）和 namespace 在 app/build.gradle.kts 里设置，这里不写 package -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- [修改] 蓝牙权限 - 更新为完整的BLE权限 -->
    <!-- Android 12 以下（<= API 30）：经典蓝牙权限 + 定位（BLE扫描需要）。
         12+ 用 BLUETOOTH_SCAN（neverForLocation），不再需要定位，所以定位权限只声明到 API 30 -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30"/>
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30"/>

    <!-- Android 12+（>= API 31）：新的BLE权限 -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"/>
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"/>

    <!-- [新增] 声明设备需要BLE能力 -->
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true"/>

    <!-- 前台服务权限 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <!-- 在线模式录制系统播放的声音（AudioPlaybackCapture）需要；不使用麦克风 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- 通知权限（Android 13+） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- NEW: 网络访问，用于拉取版本 JSON -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- NEW: 仅用于判断是否有网络 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>


    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.Helloworld">

        <!-- ✅ 视频分析页面（支持横屏切换而不重建） -->
        <activity
            android:name=".VideoProcessActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize"
            android:screenOrientation="portrait">
            <!-- target 36 起，最小宽度 >= 600dp 的屏幕（平板、折叠屏内屏）会忽略 screenOrientation 和
                 setRequestedOrientation：竖屏锁定和全屏按钮的横屏切换失效。这个属性让它保持以前的行为；
                 只是临时的，target 37 起不再生效，到时候要让这个页面自己适配任意方向 -->
            <property
                android:name="android.window.PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY"
                android:value="true" />
        </activity>


        <!-- 主页面 -->
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 在线分析Activity -->
        <activity
            android:name=".OnlineAnalysisActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize"
            android:launchMode="singleTask" />

        <!-- 手动电子菜单（脱离视频分析，直接控制模式/强度） -->
        <activity
            android:name=".ManualControlActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize"
            android:parentActivityName=".MainActivity" />

        <!-- 在线分析服务 -->
        <service
            android:name=".OnlineAnalysisService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

    </application>
</manifest>